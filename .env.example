# Use the Supabase project appropriate for the target environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only: mark Sensitive/Secret in Vercel. Never use NEXT_PUBLIC_ here.
SUPABASE_SECRET_KEY=your-server-secret-key
# Exact public HTTPS origins allowed to start/finish OAuth and sign out.
# Include production and each stable preview alias; separate multiple origins with commas.
ATLAS_AUTH_ALLOWED_ORIGINS=https://your-atlas-domain.example
